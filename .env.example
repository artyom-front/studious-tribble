# ============================================================
# SCORES21 · .env.example — шаблон конфигурации окружения
# Скопируйте в .env и заполните значения: cp .env.example .env
# Никогда не коммитьте .env в git — там секреты.
# ============================================================

# --- База данных (PostgreSQL) ---
# В docker-compose адрес БД подставляется автоматически (db:5432).
# Эта переменная нужна только для запуска БЕЗ докера (локальная разработка):
# DATABASE_URL=postgresql://scores21:scores21@localhost:5432/scores21?schema=public

# Пароль postgres (прод: подставляется в compose при старте БД и в DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Безопасность ---
# Секрет для подписи HMAC-cookie сессий. Сгенерируйте: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_RANDOM_HEX

# --- Первый администратор (используется один раз при первом деплое) ---
ADMIN_EMAIL=admin@example.ru
# Минимум 8 символов; после первого входа смените и включите 2FA
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Сайт ---
# Публичный URL (для sitemap, canonical, cookies)
SITE_URL=https://ваш-домен.ru

# Показывать демо-аккаунты на странице входа (1 = да, 0 = нет)
SHOW_DEMO_ACCOUNTS=0
